# Discord bot token. On Wispbyte this may also be named BOT_TOKEN.
DISCORD_TOKEN=replace_me
# Discord application/client ID. Needed only when registering slash commands.
DISCORD_CLIENT_ID=replace_me
# Optional aliases accepted by the runtime: BOT_TOKEN and CLIENT_ID.
# BOT_TOKEN=
# CLIENT_ID=
# Optional: register slash commands instantly in one development server.
DISCORD_GUILD_ID=
# Optional: persistent configuration path.
DATA_FILE=./data/config.json
LOG_LEVEL=info
