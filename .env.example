# Required Discord bot token. Pella can name this DISCORD_TOKEN or BOT_TOKEN.
DISCORD_TOKEN=replace_me
# JustRunMy may require a numeric value here. Use your server ID.
DISCORD_GUILD_ID=123456789012345678
# Keep true to register slash commands globally in every server.
REGISTER_GLOBAL=true
# Optional: persistent configuration path.
DATA_FILE=data/config.json
LOG_LEVEL=INFO
